@page "/produtos"
@using AulaApp1.Components.Models
@using AulaApp1.Data
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<Contexto> DbFactory

<h2>Produtos</h2>
<div class="row">
    <div class="col-md-4">
        <Cartao Titulo="Novo produto">
            <FormProduto OnProdutoCadastrado="AdicionarProduto" />
        </Cartao>
    </div>

    <div class="col-md-8">
        <TabelaProdutos Produtos="produtos" OnExcluir="ExcluirProduto" />
        @if (produtos.Count == 0)
        {
            <Aviso />
        }
    </div>
</div>

@code {
    private List<Produto> produtos = new();

    protected override async Task OnInitializedAsync()
    {
        await CarregarProdutos();
    }

    private async Task CarregarProdutos()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        produtos = await db.Produtos.OrderBy(p => p.Nome).ToListAsync();
    }

    private async Task AdicionarProduto(Produto produto)
    {
        using var db = await DbFactory.CreateDbContextAsync();
        db.Produtos.Add(produto);
        await db.SaveChangesAsync();   
        await CarregarProdutos();
    }

    private async Task ExcluirProduto(Produto produto)
    {
        using var db = await DbFactory.CreateDbContextAsync();
        db.Produtos.Remove(produto);
        await db.SaveChangesAsync();
        await CarregarProdutos();
    }
}
