@using AulaApp1.Components.Models
@page "/produtos"

<h2>Produtos</h2>
<div class="row">
    <div class="col-md-4">
        <Cartao Titulo="Novo produto">
            <FormProduto OnProdutoCadastrado="AdicionarProduto" />
        </Cartao>
    </div>

    <div class="col-md-8">
        <TabelaProdutos Produtos="produtos" />
        @if (produtos.Count == 0)
        {
            <Aviso />
        }
    </div>
</div>

@code {
    private List<Produto> produtos = new();

    private void AdicionarProduto(Produto produto)
    {
        produtos.Add(produto);
    }
}