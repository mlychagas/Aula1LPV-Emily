<h4>Produtos cadastrados</h4>
<table class="table table-striped">
    <thead>
    <tr>
        <th>Nome</th>
        <th>Preço</th>
        <th>Quantidade</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
        @foreach (var p in Produtos)
        {
            <tr>
                <td>@p.Nome</td>
                <td>R$ @p.Preco</td>
                <td>@p.Quantidade un</td>
                <td>
                    <button class="btn btn-danger btn-sm" @onclick="() => OnExcluir.InvokeAsync(p)">Excluir</button>
                </td>
            </tr>

        }
    </tbody>
</table>

@code {
    [Parameter] public List<Produto> Produtos { get; set; } = new();

    [Parameter] public EventCallback<Produto> OnExcluir { get; set; }

}